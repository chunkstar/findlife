{
  "name": "OP-COM (Node 22)",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:1-22-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md", "app/page.tsx"]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss"
      ]
    }
  },
  "updateContentCommand": "npm install -g pnpm@10 && pnpm install",
  "postAttachCommand": {
    "server": "pnpm dev"
  },
  "portsAttributes": {
    "3000": {
      "label": "OP-COM",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [3000]
}
